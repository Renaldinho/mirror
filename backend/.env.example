# Copy to .env and adjust. All values are optional (defaults shown).

# Ollama / model
OLLAMA_HOST=http://localhost:11434
# Swap freely: qwen2.5:7b | qwen2.5:3b | qwen3:8b | hf.co/<repo>:<quant>
OLLAMA_MODEL=qwen2.5:7b
# Set false for models with weak/no native tool-calling (uses NOTIFY: fallback)
OLLAMA_SUPPORTS_TOOLS=true

# Proactive scheduler (Peter bugs you unprompted)
PROACTIVE_ENABLED=true
PROACTIVE_INTERVAL_SECONDS=900

# CORS: comma-separated origins, or * for dev
CORS_ORIGINS=*
