#!/usr/bin/env bash
set -u

section() {
  echo
  echo "==> $1"
}

section "Hardware"
if [[ -r /proc/device-tree/model ]]; then
  tr -d '\0' </proc/device-tree/model
  echo
fi
uname -a
if command -v vcgencmd >/dev/null 2>&1; then
  vcgencmd get_throttled
  vcgencmd measure_temp
fi

section "Display"
if command -v wlr-randr >/dev/null 2>&1; then
  wlr-randr 2>&1 || true
elif command -v xrandr >/dev/null 2>&1; then
  xrandr --current 2>&1 || true
elif command -v fbset >/dev/null 2>&1; then
  fbset -s 2>&1 || true
else
  echo "No display information tool found."
fi

section "Browser"
if command -v chromium >/dev/null 2>&1; then
  chromium --version
elif command -v chromium-browser >/dev/null 2>&1; then
  chromium-browser --version
else
  echo "Chromium is not installed."
fi

section "Memory and storage"
free -h
df -h / /opt/mirror /var/lib/mirror 2>/dev/null || df -h /

section "Services"
systemctl is-active mirror-api nginx 2>&1 || true
systemctl --no-pager --lines=0 status mirror-api nginx 2>&1 || true

section "Health"
curl -fsS --max-time 3 http://127.0.0.1:5000/api/health 2>&1 || true
echo
curl -fsS --max-time 3 http://127.0.0.1/api/health 2>&1 || true
echo

section "Top processes"
ps -eo pid,comm,%cpu,%mem,rss --sort=-%cpu | head -n 12
